# ADW Environment Configuration
# Copy this file to .env and fill in your values.

# =============================================================================
# Required
# =============================================================================

# Path to the Claude Code CLI binary (find yours with: which claude)
CLAUDE_CODE_PATH=claude

# =============================================================================
# Optional
# =============================================================================

# Anthropic API key — only needed if your claude CLI session isn't authenticated
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# GitHub Personal Access Token — needed for GitHub-integrated workflows
# (issue classification, PR creation, review comments)
# GITHUB_PAT=your_github_pat_here

# Cloudflare tunnel token — only needed for the webhook trigger
# (adws/adw_triggers/trigger_webhook.py)
# CLOUDFLARED_TUNNEL_TOKEN=your_tunnel_token_here

# Pipeline-wide appended system prompt (opt-in A/B gate; see adw_modules/agent.py)
# ADW_PIPELINE_SYSTEM_PROMPT=false
# ADW_APPEND_SYSTEM_PROMPT_FILE=/abs/path/to/prompt.md
