# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=growbuddy
DB_NAME_TEST=growbuddy_test

# Server Configuration
PORT=3000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Redis Configuration (for BullMQ queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================================================
# AI Service Configuration
# ============================================================================

# Mock Mode: Set to true to use mock responses during development (no API keys needed)
MOCK_AI=true

# ----------------------------------------------------------------------------
# AI Provider API Keys
# At least one provider key is required if MOCK_AI=false
# ----------------------------------------------------------------------------

# Anthropic (Claude) - Primary provider for most use cases
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (GPT-4, etc.) - Alternative provider
# OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter - Multi-model gateway with access to 300+ models
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# ----------------------------------------------------------------------------
# Provider Selection
# ----------------------------------------------------------------------------

# Default provider to use (anthropic, openai, or openrouter)
AI_DEFAULT_PROVIDER=anthropic

# Fallback providers in order of preference (comma-separated)
# Used when the default provider fails or is unavailable
# AI_FALLBACK_PROVIDERS=openai,openrouter

# ----------------------------------------------------------------------------
# Model Configuration (optional - defaults shown)
# ----------------------------------------------------------------------------

# Anthropic model
AI_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI model
AI_OPENAI_MODEL=gpt-4-turbo-preview

# OpenRouter model (format: provider/model-name)
AI_OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# ----------------------------------------------------------------------------
# OpenRouter-specific Settings (optional)
# Used for attribution on OpenRouter leaderboard
# ----------------------------------------------------------------------------

# OPENROUTER_SITE_URL=https://your-app-url.com
# OPENROUTER_SITE_NAME=YourAppName

# ----------------------------------------------------------------------------
# Request Configuration (optional - defaults shown)
# ----------------------------------------------------------------------------

# Maximum tokens in AI responses
AI_MAX_TOKENS=1024

# Temperature for response generation (0-1, higher = more creative)
AI_TEMPERATURE=0.7

# Request timeout in milliseconds
AI_TIMEOUT=30000

# Retry configuration
AI_RETRY_ATTEMPTS=3
AI_RETRY_DELAY=1000
AI_MAX_RETRY_DELAY=10000

# ============================================================================
# Queue Configuration (optional)
# ============================================================================

QUEUE_CONCURRENCY=5
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY=1000

# ============================================================================
# WebSocket Configuration (optional)
# ============================================================================

WEBSOCKET_CORS_ORIGIN=http://localhost:3000
WEBSOCKET_AUTH_REQUIRED=true

# ============================================================================
# File Upload Configuration
# ============================================================================

# Directory for storing uploaded files (relative to backend root)
UPLOAD_DIR=uploads/grows

# Maximum file size in megabytes
MAX_FILE_SIZE_MB=10

# Thumbnail size in pixels (width and height)
THUMBNAIL_SIZE=200
